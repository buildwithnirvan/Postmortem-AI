# Copy to .env and fill in. Never commit the real .env.

# --- Hindsight (required) ---
# Hindsight Cloud: sign in at https://ui.hindsight.vectorize.io and copy your API URL + API key.
# Self-hosted: use the URL of your running Hindsight API server (API key may be empty).
HINDSIGHT_BASE_URL=https://REPLACE_WITH_YOUR_HINDSIGHT_API_URL
HINDSIGHT_API_KEY=REPLACE_WITH_YOUR_HINDSIGHT_API_KEY
HINDSIGHT_BANK_ID=postmortem-demo
HINDSIGHT_TIMEOUT_SECONDS=120

# --- LLM (required): Groq, OpenAI-compatible endpoint ---
GROQ_API_KEY=REPLACE_WITH_YOUR_GROQ_API_KEY
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- App ---
POSTMORTEM_DB_PATH=postmortem.db
RECALL_MAX_TOKENS=3000
RECALL_BUDGET=mid
